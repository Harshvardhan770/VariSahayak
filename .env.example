# Copy to .env at the repository root and fill in. .env is git-ignored.
#
#   cp .env.example .env
#
# Values are read at build time by app/build.gradle.kts. In CI, set the same names as
# environment variables instead and leave .env absent — the build falls back to them.
#
# Everything here is a PUBLISHABLE credential. It is compiled into the APK and can be
# extracted from it. Keeping .env out of git prevents credential sprawl and makes
# rotation cheap; it is not a confidentiality boundary. What actually protects the
# system is PostgreSQL Row Level Security and the Maps key restriction.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Supabase anon / publishable key. Designed to be public and guarded by RLS.
# Never the service-role key.
SUPABASE_ANON_KEY=

# Google Maps SDK for Android key.
# Restrict it in Google Cloud Console to the application ID (com.varisahayak) and your
# signing certificate SHA-1. An unrestricted key is billable by anyone who extracts it.
GOOGLE_MAPS_API_KEY=

# Face-matching service, for reference only.
#
# The Android app does NOT call this service and does not need this value: it talks to
# Supabase, and the process-face Edge Function talks to the face service. Recorded here so
# the deployed address lives in one git-ignored place rather than in somebody's shell
# history, and so a debug build that ever needs a direct path has somewhere to read it from.
#
# Set the real value on the backend, where it is actually used:
#
#   supabase secrets set FACE_SERVICE_URL=http://<face-service-host>:8080
#   supabase secrets set FACE_SERVICE_TOKEN=<same value as the service's FACE_API_KEY>
#
# No trailing slash there: the function appends /enroll and /compare directly.
FACE_API_URL=http://<face-service-host>:8080/

# -----------------------------------------------------------------------------
# NEVER put these here, in local.properties, in Gradle files, or in app resources.
# They are server-side only and must never reach the APK:
#
#   SUPABASE_SERVICE_ROLE_KEY
#   GEMINI_API_KEY
#
# Set them on the backend instead:
#
#   supabase secrets set GEMINI_API_KEY=...
#
# and read them inside an Edge Function with Deno.env.get('GEMINI_API_KEY').
# -----------------------------------------------------------------------------
