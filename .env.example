# Copy to .env at the repository root and fill in. .env is git-ignored.
#
#   cp .env.example .env
#
# Values are read at build time by app/build.gradle.kts. In CI, set the same names as
# environment variables instead and leave .env absent — the build falls back to them.
#
# Everything here is a PUBLISHABLE credential. It is compiled into the APK and can be
# extracted from it. Keeping .env out of git prevents credential sprawl and makes
# rotation cheap; it is not a confidentiality boundary. What actually protects the
# system is PostgreSQL Row Level Security and the Maps key restriction.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Supabase anon / publishable key. Designed to be public and guarded by RLS.
# Never the service-role key.
SUPABASE_ANON_KEY=

# Google Maps SDK for Android key.
# Restrict it in Google Cloud Console to the application ID (com.varisahayak) and your
# signing certificate SHA-1. An unrestricted key is billable by anyone who extracts it.
GOOGLE_MAPS_API_KEY=

# Face-matching service, for reference only.
#
# The Android app does NOT call this service and does not need this value: it talks to
# Supabase, and the process-face Edge Function talks to the face service. Recorded here so
# the deployed address lives in one git-ignored place rather than in somebody's shell
# history, and so a debug build that ever needs a direct path has somewhere to read it from.
#
# Set the real values on the backend, where they are actually used:
#
#   supabase secrets set FACE_API_URL=http://<face-service-host>
#   supabase secrets set FACE_API_KEY=<the service's own FACE_API_KEY>
#
# The names match what the deployed service calls them (see its .env.example), so one name
# means one thing on both sides. The Edge Function still reads the older FACE_SERVICE_URL /
# FACE_SERVICE_TOKEN as a fallback, but those are deprecated: FACE_SERVICE_TOKEN was sent
# as an `X-Service-Token` header, and the deployed service answers that with 401. It reads
# `X-API-Key` and nothing else.
#
# A trailing slash is tolerated — the function strips it before appending a route — but
# leave it off. The routes are /v1/face/register, /v1/face/match and /v1/face/detect; there
# is no /enroll and no /compare on the deployed build.
FACE_API_URL=http://<face-service-host>

# LiveKit signalling address for the walkie-talkie, e.g. ws://34.100.11.22:7880
#
# This is an ADDRESS, not a credential. It is compiled into the APK as
# BuildConfig.LIVEKIT_URL and is also what the debug build's network-security-config names
# as its single cleartext exception (see app/build.gradle.kts). It is kept out of git for
# the same reason as everything else here: an IP in source is one push from being public,
# and this one points at a machine strangers can then try to join.
#
# ws:// not wss:// — the demo server is a bare GCE IP with no domain and therefore no TLS
# certificate. The LiveKit Android SDK is not a browser and does not require a secure
# transport. WebRTC media is SRTP-encrypted regardless, so what is exposed is the
# signalling channel, not the voice. Fine for a demo on a throwaway VM; production needs a
# domain, a certificate, and wss://.
#
# Leave it EMPTY and the radio reports itself as not configured. That is the intended
# behaviour for a build with no server — the widget must never show a live-looking
# push-to-talk button that carries no audio.
#
# The matching server-side secrets are set on Supabase, NOT here:
#
#   supabase secrets set LIVEKIT_URL=ws://<ip>:7880
#   supabase secrets set LIVEKIT_API_KEY=<key from livekit.yaml>
#   supabase secrets set LIVEKIT_API_SECRET=<secret from livekit.yaml>
#
# LIVEKIT_API_SECRET is the signing key for join tokens. It must never appear in this file,
# in Gradle, or in the APK: with it, anyone can mint a token for the emergency channel.
LIVEKIT_URL=

# -----------------------------------------------------------------------------
# NEVER put these here, in local.properties, in Gradle files, or in app resources.
# They are server-side only and must never reach the APK:
#
#   SUPABASE_SERVICE_ROLE_KEY
#   GEMINI_API_KEY
#
# Set them on the backend instead:
#
#   supabase secrets set GEMINI_API_KEY=...
#
# and read them inside an Edge Function with Deno.env.get('GEMINI_API_KEY').
# -----------------------------------------------------------------------------
