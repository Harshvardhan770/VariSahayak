# VARI Sahayak face-matching service configuration.
#
# Copy to .env and fill in. Never commit the filled-in file — .env is gitignored at the
# repository root.

# The project's existing PostgreSQL/Supabase database. This service connects with the
# SERVICE ROLE credentials because lost_found_face_data grants nothing to any client role.
# That key must never reach the Android app or the public website.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Shared secret between the Supabase edge function and this service. A missing value makes
# the service refuse every request rather than run open.
FACE_SERVICE_TOKEN=

# Comma-separated. The backend only — this service is never called from a browser.
ALLOWED_ORIGINS=

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
