# VARI Sahayak Lost & Found face-matching service.
#
# Copy to .env and fill in. Never commit the filled-in file — .env is gitignored at the
# repository root. In production these are set as container environment variables rather
# than shipped in the image.

# --- MongoDB -----------------------------------------------------------------------------
# The ONLY datastore this service uses. There is no PostgreSQL or Supabase connection here;
# this process holds no database service-role key of any kind.
#
# Use a dedicated user scoped to this one database, with readWrite and nothing more. It
# stores biometric vectors, so it should not share credentials with anything else.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=varisahayak_faces
MONGODB_COLLECTION=face_profiles

# Connection behaviour. Defaults suit a single Compute Engine VM talking to a managed
# cluster in the same region; raise the timeouts if the database is a region away.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0

# --- authentication ----------------------------------------------------------------------
# Shared secret between the backend and this service, sent as X-API-Key (X-Service-Token is
# also accepted, for the backend that predates the rename). An empty value makes the
# service refuse every authenticated request rather than run open.
#
# Generate with: openssl rand -hex 32
FACE_API_KEY=

# --- matching ----------------------------------------------------------------------------
# Cosine distance. Lower is more similar; a pair at or below MATCH_THRESHOLD is worth a
# human's attention and nothing more. This is an inherited engineering starting point, NOT
# a validated identity threshold — tune it against representative Wari photographs before
# relying on it operationally. Callers may override it per request.
MATCH_THRESHOLD=0.40

# How far clear of the runner-up a candidate must be to be labelled confident.
MATCH_CONFIDENT_MARGIN=0.08

# Ranked candidates returned per detected face.
MAX_MATCH_RESULTS=5

FACE_MODEL=Facenet
DETECTOR_REGISTRATION=opencv
DETECTOR_RECOGNITION=retinaface

# --- image limits ------------------------------------------------------------------------
MAX_IMAGE_BYTES=8388608
MIN_IMAGE_DIMENSION=64
MAX_FACES_PER_IMAGE=10
MAX_REFERENCE_IMAGES=5
FACE_CONFIDENCE_THRESHOLD=0.5

# Cropped thumbnails returned by /detect_faces. These are crops of the caller's own upload;
# set to false if you would rather no image data came back at all.
DETECT_RETURN_THUMBNAILS=true
THUMBNAIL_MAX_EDGE=160
THUMBNAIL_JPEG_QUALITY=80

# --- augmentation ------------------------------------------------------------------------
# Enrolment averages the embedding over synthetic variants of the reference crop, which
# makes the stored vector far less sensitive to the angle and light of one photograph.
# Turning this off is roughly 8x faster per enrolment and measurably less accurate.
AUGMENTATION_ENABLED=true
AUGMENT_FLIP=true
AUGMENT_ROTATION_DEGREES=12
AUGMENT_BRIGHTNESS_DELTA=30
AUGMENT_CONTRAST_HIGH=1.3
AUGMENT_CONTRAST_LOW=0.75
AUGMENT_ZOOM_RATIO=0.08
FACE_CROP_MARGIN_RATIO=0.15

# --- server ------------------------------------------------------------------------------
# 0.0.0.0 because the process listens inside a container; the port is published to the host
# by Docker and fronted by the VM firewall or a reverse proxy.
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
SERVICE_VERSION=2.0.0

# Comma-separated browser origins. Empty — the default — allows none, which is correct:
# this service is called by a backend, never from a page.
ALLOWED_ORIGINS=

# --- container ---------------------------------------------------------------------------
# Gunicorn. Keep workers low: each one loads its own copy of the Facenet weights, and two
# workers on a 2-vCPU VM will thrash. Scale with threads and timeout instead.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
